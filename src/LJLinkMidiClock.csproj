<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
    <WindowsSDKPackageVersion>10.0.26100.57</WindowsSDKPackageVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>LJLinkMidiClock</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <PlatformTarget>x64</PlatformTarget>
    <CSWinRTIncludes>Windows.Devices.Midi2</CSWinRTIncludes>
    <CSWinRTInputs>Windows.Devices.Midi2</CSWinRTInputs>
    <Version>0.1.0</Version>
    <PackageLicenseExpression>GPL-2.0-or-later</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.2.0" />
    <Reference Include="../.deps/sdk/Windows.Devices.Midi2.winmd" />
    <Content Include="../.deps/sdk/Windows.Devices.Midi2.dll" Link="Windows.Devices.Midi2.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../.deps/sdk/Windows.Devices.Midi2.pri" Link="Windows.Devices.Midi2.pri" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="../.deps/carabiner/Carabiner.exe" Link="Carabiner.exe" />
  </ItemGroup>
</Project>
